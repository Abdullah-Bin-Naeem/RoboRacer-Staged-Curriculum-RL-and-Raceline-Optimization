# colcon output, if the repo root is ever built in place as a workspace. The
# image builds it itself; a host build tree in the context would only slow the
# build down.
build/
install/
log/

__pycache__/
*.pyc
*.egg-info/

# Run logs written by the entrypoint inside the container.
*.log

# Benchmark output: scripts/bench.sh mounts this into the bench container and
# every recording, report and generated AMCL variant lands here. Runs are
# machine- and session-specific (the sim tick rate moves with the host), so
# they are evidence for one sitting, not artefacts to carry in the repo.
runs/
