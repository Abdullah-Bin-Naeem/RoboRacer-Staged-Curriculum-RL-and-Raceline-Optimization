# ament_flake8's own configuration, with two deviations for this codebase.
# test/test_flake8.py passes this file explicitly, because ament_flake8 uses its
# built-in ini otherwise and does not read setup.cfg.
#
#   max-line-length  99 -> 120. This code wraps at about 100 and the launch
#                    files carry long resolved share paths.
#   E731             deliberate. The nodes use one-line lambdas for the
#                    subscription callbacks that only forward a single field.
#   E702             deliberate. A few paired assignments read better on one
#                    line than as four.
[flake8]
extend-ignore = B902,C816,D100,D101,D102,D103,D104,D105,D106,D107,D203,D212,D404,I202,E731,E702
import-order-style = google
max-line-length = 120
show-source = true
statistics = true
