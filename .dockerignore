# The Dockerfile copies roboracer_stack/ and the entrypoint, and nothing else.
# Anything a development checkout leaves lying around at the repo root stays
# out of the build context.
/logs/
/runs/
/runs_docker/
/raceline/
/experiments/
/scripts/
/tools/
*.csv
*.npz
*.log
image.png

# colcon artefacts, if the repo was ever built in place
build/
install/
log/
**/__pycache__/
**/*.pyc
**/*.egg-info/
.git/
.claude/

# Built into the image from roboracer_stack/tools/nodelay.c; never copied in.
**/libnodelay.so
