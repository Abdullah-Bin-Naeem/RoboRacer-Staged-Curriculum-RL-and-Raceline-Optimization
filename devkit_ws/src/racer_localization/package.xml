<?xml version="1.0"?>
<package format="3">
  <name>racer_localization</name>
  <version>0.1.0</version>
  <description>Localization for the AutoDRIVE RoboRacer: encoder+IMU dead
  reckoning, and three interchangeable map-relative localizers (nav2 AMCL
  against an occupancy grid, slam_toolbox against a serialized pose graph, and
  localization_v2: segmented scan-to-map matching against the grid) behind the
  same frames and the same error instrument.</description>
  <maintainer email="abdullahbinnaeempro@gmail.com">Abdullah Bin Naeem</maintainer>
  <license>BSD</license>

  <exec_depend>rclpy</exec_depend>
  <exec_depend>racer_common</exec_depend>
  <exec_depend>geometry_msgs</exec_depend>
  <exec_depend>nav_msgs</exec_depend>
  <exec_depend>sensor_msgs</exec_depend>
  <exec_depend>std_msgs</exec_depend>
  <exec_depend>std_srvs</exec_depend>
  <exec_depend>tf2_ros</exec_depend>
  <!-- Needed by localization_bootstrap, which polls AMCL's lifecycle state. -->
  <exec_depend>lifecycle_msgs</exec_depend>
  <!-- Declared here for the first time: racer_control launched all of these
       without ever depending on them. -->
  <exec_depend>nav2_amcl</exec_depend>
  <exec_depend>nav2_map_server</exec_depend>
  <exec_depend>nav2_lifecycle_manager</exec_depend>
  <exec_depend>slam_toolbox</exec_depend>

  <export><build_type>ament_python</build_type></export>
</package>
