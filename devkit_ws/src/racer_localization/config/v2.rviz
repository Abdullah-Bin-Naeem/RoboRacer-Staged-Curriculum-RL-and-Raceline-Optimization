Panels:
  - Class: rviz_common/Displays
    Name: Displays
    Property Tree Widget:
      Expanded: [/V2Pose1, /GroundTruth1]
      Splitter Ratio: 0.5
    Tree Height: 700
Visualization Manager:
  Class: ""
  Displays:
    - Class: rviz_default_plugins/Grid
      Name: Grid
      Enabled: true
      Alpha: 0.25
      Cell Size: 1
      Plane Cell Count: 40
      Color: 160; 160; 164
      Reference Frame: <Fixed Frame>
      Value: true
    - Class: rviz_default_plugins/Map
      Name: Map
      Enabled: true
      Alpha: 0.85
      Color Scheme: map
      Draw Behind: true
      Topic:
        Value: /map
        Depth: 1
        Durability Policy: Transient Local
        Reliability Policy: Reliable
      Value: true
    - Class: rviz_default_plugins/LaserScan
      Name: LaserScan
      Enabled: true
      Topic:
        Value: /autodrive/roboracer_1/lidar
        Depth: 5
        Durability Policy: Volatile
        Reliability Policy: Reliable
      Style: Points
      Size (Pixels): 3
      Color: 255; 85; 0
      Color Transformer: FlatColor
      Decay Time: 0
      Value: true
    - Class: rviz_default_plugins/Path
      Name: RacelinePath
      Enabled: true
      Topic:
        Value: /pure_pursuit/path
        Depth: 1
        Durability Policy: Volatile
        Reliability Policy: Reliable
      Color: 0; 200; 0
      Line Style: Lines
      Value: true
    - Class: rviz_default_plugins/PoseWithCovariance
      Name: V2Pose
      Enabled: true
      Topic:
        Value: /localization_v2/pose
        Depth: 5
        Durability Policy: Volatile
        Reliability Policy: Reliable
      Shape: Arrow
      Color: 30; 110; 255
      Alpha: 1
      Shaft Length: 0.4
      Shaft Radius: 0.04
      Head Length: 0.15
      Head Radius: 0.09
      Covariance:
        Value: true
        Position:
          Alpha: 0.30
          Color: 30; 110; 255
          Scale: 1
        # Orientation covariance OFF: amcl's initial covariance is not always
        # positive semidefinite, and RViz logs "Negative eigenvalue found" /
        # "shape_scale contains NaN" trying to draw the ellipse from it. The
        # position ellipse carries the information worth seeing anyway.
        Orientation:
          Value: false
          Alpha: 0.4
          Color: 255; 255; 127
          Scale: 1
          Offset: 1
      Value: true
    - Class: rviz_default_plugins/Odometry
      Name: GroundTruth
      Enabled: true
      Topic:
        Value: /autodrive/roboracer_1/odom
        Depth: 5
        Durability Policy: Volatile
        Reliability Policy: Reliable
      Shape: Arrow
      Position Tolerance: 0.02
      Angle Tolerance: 0.02
      Keep: 1
      Color: 255; 40; 40
      Alpha: 1
      Shaft Length: 0.4
      Shaft Radius: 0.04
      Head Length: 0.15
      Head Radius: 0.09
      Covariance:
        Value: false
      Value: true
    - Class: rviz_default_plugins/Marker
      Name: Lookahead
      Enabled: true
      Topic:
        Value: /pure_pursuit/lookahead
        Depth: 5
        Durability Policy: Volatile
        Reliability Policy: Reliable
      Value: true
    - Class: rviz_default_plugins/TF
      Name: TF
      Enabled: true
      Show Names: true
      Show Axes: true
      Show Arrows: false
      Marker Scale: 0.4
      Frame Timeout: 15
      Frames:
        All Enabled: false
        map: {Value: true}
        odom: {Value: true}
        roboracer_1: {Value: true}
        lidar: {Value: true}
        world: {Value: false}
      Value: true
  Enabled: true
  Global Options:
    Fixed Frame: map
    Background Color: 48; 48; 48
    Frame Rate: 30
  Name: root
  Tools:
    - Class: rviz_default_plugins/MoveCamera
    - Class: rviz_default_plugins/SetInitialPose
      Topic: {Value: /initialpose}
    - Class: rviz_default_plugins/Measure
  Value: true
  Views:
    Current:
      Class: rviz_default_plugins/TopDownOrtho
      Name: Current View
      Angle: 0
      Scale: 60
      Target Frame: <Fixed Frame>
      X: -1.0
      Y: -0.7
    Saved: ~
Window Geometry:
  Displays: {collapsed: false}
  Height: 1000
  Width: 1500
  Hide Left Dock: false
  Hide Right Dock: true
