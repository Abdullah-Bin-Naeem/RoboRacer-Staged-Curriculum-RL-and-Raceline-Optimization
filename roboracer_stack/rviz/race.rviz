Panels:
  - Class: rviz_common/Displays
    Name: Displays
    Property Tree Widget:
      Expanded: ~
    Tree Height: 500
  - Class: rviz_common/Views
    Name: Views
Visualization Manager:
  Class: ""
  Displays:
    - Class: rviz_default_plugins/Grid
      Enabled: true
      Name: Grid
      Cell Size: 1
      Plane Cell Count: 40
      Line Style:
        Line Width: 0.03
        Value: Lines
      Color: 90; 90; 90
      Alpha: 0.5
      Reference Frame: map
    - Class: rviz_default_plugins/Map
      Enabled: true
      Name: Map (track_clean)
      Topic:
        Depth: 5
        Durability Policy: Transient Local
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /map
      Update Topic:
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /map_updates
      Color Scheme: map
      Draw Behind: true
      Alpha: 0.8
    - Class: rviz_default_plugins/TF
      Enabled: true
      Name: TF (map → odom → roboracer_1 → lidar)
      Show Arrows: false
      Show Axes: true
      Show Names: true
      Marker Scale: 0.4
      Frame Timeout: 15
      Frames:
        All Enabled: true
    - Class: rviz_default_plugins/LaserScan
      Enabled: true
      Name: LiDAR
      Topic:
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Best Effort
        Value: /autodrive/roboracer_1/lidar
      Style: Points
      Size (Pixels): 3
      Color Transformer: FlatColor
      Color: 255; 140; 0
      Alpha: 1
      Decay Time: 0
      Queue Size: 10
    - Class: rviz_default_plugins/Path
      Enabled: true
      Name: Raceline (pure_pursuit/path)
      Topic:
        Depth: 5
        Durability Policy: Transient Local
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /pure_pursuit/path
      Line Style: Billboards
      Line Width: 0.04
      Color: 176; 23; 92
      Alpha: 1
      Buffer Length: 1
      Pose Style: None
    - Class: rviz_default_plugins/Marker
      Enabled: true
      Name: Lookahead target
      Topic:
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /pure_pursuit/lookahead
      Namespaces: {}
    - Class: rviz_default_plugins/PoseWithCovariance
      Enabled: true
      Name: AMCL pose
      Topic:
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /amcl_pose
      Shape: Arrow
      Color: 12; 116; 128
      Alpha: 1
      Head Length: 0.1
      Head Radius: 0.06
      Shaft Length: 0.3
      Shaft Radius: 0.03
      Covariance:
        Value: true
        Position:
          Value: true
          Alpha: 0.3
          Color: 12; 116; 128
          Scale: 1
        Orientation:
          Value: false
  Global Options:
    Background Color: 32; 36; 35
    Fixed Frame: map
    Frame Rate: 30
  Name: root
  Tools:
    - Class: rviz_default_plugins/MoveCamera
    - Class: rviz_default_plugins/Select
    - Class: rviz_default_plugins/Measure
    - Class: rviz_default_plugins/SetInitialPose
      Topic:
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /initialpose
  Value: true
  Views:
    Current:
      Class: rviz_default_plugins/TopDownOrtho
      Name: Top-down
      Scale: 38
      X: 2.6
      Y: -6.0
      Angle: 1.5708
      Near Clip Distance: 0.01
      Invert Z Axis: false
      Target Frame: <Fixed Frame>
    Saved: ~
Window Geometry:
  Height: 1000
  Width: 1500
  Displays:
    collapsed: false
  Views:
    collapsed: true
