# ---- ROS 2 build artifacts -------------------------------------------------
build/
install/
log/
*.egg-info/

# ---- Python ----------------------------------------------------------------
__pycache__/
*.py[cod]
.venv*/
.ipynb_checkpoints/

# ---- Simulator (~382 MB Unity build each) ----------------------------------
# Download from the AutoDRIVE releases page; not ours to redistribute.
# simulator_comp/ was committed by accident in 16264e1 (370 MB across 31 files,
# including three over GitHub's 50 MB warning threshold). Untracked again here;
# note that only removes it from future commits -- the blobs stay in the pushed
# history until someone rewrites it.
simulator_practice/
simulator_comp/

# ---- RL training artifacts (~30 GB) ----------------------------------------
# Replay buffers are 224-247 MB each and 132 of them exist. Never commit these.
*.pkl
*replay_buffer*

# Ignore the run directories wholesale, then re-admit a few small policies.
# Note the pattern order: git cannot re-include a file whose parent directory is
# excluded, so directories have to be un-ignored on the way down.
rl_racer/runs/*
!rl_racer/runs/*/
rl_racer/runs/*/*
!rl_racer/runs/*/final.zip
!rl_racer/runs/*/monitor.csv
!rl_racer/runs/*/checkpoints/
rl_racer/runs/*/checkpoints/*
# The two policies actually referenced in the docs and used for testing.
!rl_racer/runs/stage2_sensors/checkpoints/sac_520000_steps.zip
!rl_racer/runs/stage3_v3/checkpoints/sac_990000_steps.zip

# Tensorboard event files
events.out.tfevents.*

# ---- SLAM serialized pose graph (30 MB) ------------------------------------
# Regenerable, and only needed to CONTINUE a mapping session. The .pgm + .yaml
# are the actual deliverable and are committed.

# Serializing from the RViz SlamToolbox panel with an empty name writes
# `.posegraph` and `.data` into the node's working directory -- byte-identical
# junk copies of whatever map was open. Root-anchored so the real maps under
# racer_mapping/maps/ stay tracked; track_sm.posegraph + track_sm.data ARE a
# deliverable, since slam_localization.launch.py loads them.
/.posegraph
/.data
tools/libnodelay.so
runs_docker/
# run_mt.sh (and anything else writing log_csv into the mounted logs/) drops run
# CSVs here; only the racer_*.log files in logs/ are tracked.
logs/*.csv
