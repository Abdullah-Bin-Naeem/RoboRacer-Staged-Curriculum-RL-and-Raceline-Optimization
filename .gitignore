# colcon output, if the repo root is ever built in place as a workspace. The
# image builds it itself; a host build tree in the context would only slow the
# build down.
build/
install/
log/

__pycache__/
*.pyc
*.egg-info/

# The LD_PRELOAD shim is compiled inside the image, never committed.
libnodelay.so

# Development leftovers that are not part of this branch.
logs/
runs/
runs_docker/
