<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">

  <name>roboracer_stack</name>
  <version>0.1.0</version>
  <description>Autonomous racing stack for the AutoDRIVE RoboRacer: encoder+IMU
  dead reckoning, map-relative localization (nav2 AMCL), and pure pursuit
  along a pre-optimized minimum-curvature raceline. The Porto map and the
  racing line ship inside this package.

  A separate package from autodrive_roboracer, which is used unmodified, as the
  competition rules require.</description>

  <maintainer email="abdullahbinnaeempro@gmail.com">Abdullah Bin Naeem</maintainer>
  <license>BSD</license>

  <exec_depend>rclpy</exec_depend>
  <!-- frames.py resolves the map and raceline directories through the ament index -->
  <exec_depend>ament_index_python</exec_depend>

  <exec_depend>geometry_msgs</exec_depend>
  <exec_depend>nav_msgs</exec_depend>
  <exec_depend>sensor_msgs</exec_depend>
  <exec_depend>std_msgs</exec_depend>
  <exec_depend>std_srvs</exec_depend>
  <exec_depend>visualization_msgs</exec_depend>
  <exec_depend>tf2_ros</exec_depend>
  <!-- Needed by localization/bootstrap.py, which polls AMCL's lifecycle state. -->
  <exec_depend>lifecycle_msgs</exec_depend>

  <!-- Launched by launch/amcl.launch.py. None of
       these are in the base image; the Dockerfile apt-installs them. -->
  <exec_depend>nav2_amcl</exec_depend>
  <exec_depend>nav2_map_server</exec_depend>
  <exec_depend>nav2_lifecycle_manager</exec_depend>

  <!-- The devkit bridge, composed by launch/bridge.launch.py and never modified. -->
  <exec_depend>autodrive_roboracer</exec_depend>

  <!-- test/ is the flake8 gate only. ament_copyright and ament_pep257 are the
       other two the devkit template ships; this codebase carries no copyright
       headers and its docstring style is its own, so they are not gates here. -->
  <test_depend>ament_flake8</test_depend>
  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>

</package>
